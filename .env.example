APP_ENV=development
API_ADDR=:8080
LOG_LEVEL=debug

DATABASE_URL=postgres://kb_user:kb_password@postgres:5432/knowledgebase?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

JWT_ISSUER=knowledgebase-ai
JWT_AUDIENCE=knowledgebase-api
JWT_ACCESS_TTL=15m
JWT_SIGNING_KEY=change-me-to-a-very-secure-random-secret-key-at-least-32-bytes
REFRESH_TOKEN_TTL=720h

GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/var/lib/knowledgebase/uploads
MAX_UPLOAD_BYTES=10485760

INGESTION_MAX_RETRIES=5
INGESTION_TIMEOUT=10m
WORKER_CONCURRENCY=4
